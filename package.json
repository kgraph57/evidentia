{
  "name": "evidentia",
  "version": "1.1.0",
  "description": "Catch AI-fabricated medical citations before you publish. Verifies DOIs, PMIDs, arXiv IDs, NCT records, and metadata against public registries; grades the result in a 4-tier classification. CLI + MCP server.",
  "keywords": [
    "medical",
    "fact-check",
    "citation",
    "hallucination",
    "doi",
    "pubmed",
    "arxiv",
    "clinicaltrials",
    "crossref",
    "openalex",
    "evidence-based-medicine",
    "mcp"
  ],
  "homepage": "https://github.com/kgraph57/evidentia#readme",
  "bugs": "https://github.com/kgraph57/evidentia/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kgraph57/evidentia.git"
  },
  "license": "MIT",
  "author": "Ken Okamoto, MD",
  "type": "module",
  "bin": {
    "evidentia": "dist/cli.js",
    "evidentia-mcp": "dist/mcp.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js dist/mcp.js",
    "dev": "tsc -w -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test .tmp-test/test/*.test.js",
    "test:unit": "npm run build:test && node --test .tmp-test/test/cli.test.js .tmp-test/test/mcp.test.js .tmp-test/test/extract.test.js .tmp-test/test/classify.test.js .tmp-test/test/report.test.js .tmp-test/test/text.test.js .tmp-test/test/aggregate.test.js",
    "test:live": "npm run build:test && EVIDENTIA_LIVE=1 node --test .tmp-test/test/verify.live.test.js",
    "bench": "node benchmark/run.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "typescript": "^5.7.2"
  }
}
